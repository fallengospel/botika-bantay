{
  "name": "botika-bantay",
  "version": "0.1.0",
  "private": true,
  "description": "BotikaBantay - Medicine Price Comparison & Authenticity Verification Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @botika-bantay/web",
    "dev:mobile": "npm run start --workspace @botika-bantay/mobile",
    "build:web": "npm run build --workspace @botika-bantay/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npx supabase db push",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:import": "npx tsx scripts/sync-fda.ts",
    "db:reset": "npx supabase db reset"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "tsx": "^4.23.13",
    "vercel": "^59.25.4"
  }
}
