{
  "name": "botika-bantay",
  "version": "0.1.0",
  "private": true,
  "description": "BotikaBantay - Medicine Price Comparison & Authenticity Verification Platform",
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:mobile": "cd apps/mobile && npm start",
    "build:web": "cd apps/web && npm run build",
    "lint": "echo 'Linting not configured yet. Run eslint manually per app.'",
    "db:migrate": "npx supabase db push",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:reset": "npx supabase db reset"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "tsx": "^4.23.13"
  }
}
