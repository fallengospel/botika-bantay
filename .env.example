# Supabase (Web - Next.js)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase (Mobile - Expo) - same values, different prefix for Expo
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Admin (seed + admin moderation — never commit; required on Vercel for admin PATCH)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Upstash Redis (optional — shared rate limiter, QA-008; falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BotikaBantay

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key
